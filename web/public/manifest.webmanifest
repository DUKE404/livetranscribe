{
  "name": "LiveTranscribe",
  "short_name": "LiveTranscribe",
  "description": "Transkrypcja mowy na żywo i eksport do PDF",
  "lang": "pl",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F7F8FC",
  "theme_color": "#2456E6",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nowa transkrypcja",
      "short_name": "Nagrywaj",
      "url": "/#/rec?auto=1",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Historia",
      "url": "/#/history",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/mp4",
            "application/ogg",
            ".m4a",
            ".mp3",
            ".wav",
            ".ogg",
            ".opus",
            ".flac",
            ".aac",
            ".amr",
            ".3gp"
          ]
        }
      ]
    }
  }
}
